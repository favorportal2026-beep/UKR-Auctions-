# Ключі для веб-дашборда (Фаза 2). Локально — цей файл як .env.local;
# на Vercel — Environment Variables (ті самі імена).
#
# Дашборд ходить у Supabase ЛИШЕ з сервера (service_role); у браузер ключ не потрапляє,
# тому RLS лишається закритим і дані не публічні. Це той самий проєкт, що й колектор.

SUPABASE_URL=https://kfltwtfekzddipjvrxwn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Необов'язково: простий спільний пароль-гейт. Якщо задано — сторінки просять пароль
# (щоб URL не був повністю відкритим). Порожньо = без гейту.
APP_PASSWORD=
