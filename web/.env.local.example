# Ключі для веб-дашборда (Фаза 2). Локально — цей файл як .env.local;
# на Vercel — Environment Variables (ті самі імена).
#
# Дашборд ходить у Supabase ЛИШЕ з сервера (service_role); у браузер ключ не потрапляє,
# тому RLS лишається закритим і дані не публічні. Це той самий проєкт, що й колектор.

SUPABASE_URL=https://kfltwtfekzddipjvrxwn.supabase.co
# Секретний серверний ключ (обходить RLS). Підходить новий формат
# Supabase «Secret key» (sb_secret_…) АБО старий JWT service_role.
# Брати саме Secret, НЕ Publishable (той не бачить рядків при закритому RLS).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Необов'язково: простий спільний пароль-гейт. Якщо задано — сторінки просять пароль
# (щоб URL не був повністю відкритим). Порожньо = без гейту.
APP_PASSWORD=

# Мапа (Mapbox GL). ПУБЛІЧНИЙ токен, що починається з pk. — потрапляє у браузер,
# тож це нормально (не секрет). Free tier Mapbox: 50 000 завантажень мапи/міс.
# Взяти: mapbox.com → Account → Tokens → Default public token (або створити новий).
# Якщо на токені ввімкнені URL-обмеження — додай продакшн-домен у Allowed URLs.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk....
