# ── Supabase ──────────────────────────────────────────────
# Project URL та СЕКРЕТНИЙ серверний ключ (Settings → API у Supabase).
# Потрібен для запису з бекенду/Actions (обходить RLS). Підходить новий формат
# «Secret key» (sb_secret_…) АБО старий JWT service_role. НЕ Publishable/anon.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Prozorro.Sale ─────────────────────────────────────────
# Базові URL відкритого API (ЦБД-New). Зазвичай міняти не треба.
PROZORRO_API_BASE=https://procedure.prozorro.sale/api
# Окремий інстанс для активів банків-банкрутів (ФГВФО). Опційно.
PROZORRO_DGF_API_BASE=https://dgf-procedure.prozorro.sale/api
# З якої дати починати перший забір (ISO). Далі курсор рухається сам.
PROZORRO_START_DATE=2026-09-01

# ── СЕТАМ ─────────────────────────────────────────────────
# Пряме посилання на CSV-ресурс набору data.gov.ua (найсвіжіший помісячний файл
# auctions-DD-MM-YYYY.csv). Список ресурсів — на сторінці набору:
#   https://data.gov.ua/dataset/c360d1ef-4eee-4158-812f-ede20c4cc943
# Приклад (заголовки CSV уже звірено, див. CLAUDE.md):
#   https://data.gov.ua/dataset/c360d1ef-4eee-4158-812f-ede20c4cc943/resource/<RESOURCE-ID>/download/auctions-DD-MM-YYYY.csv
SETAM_CSV_URL=

# ── Telegram сповіщення ───────────────────────────────────
# Створити бота через @BotFather, взяти token; chat_id — ваш або групи.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Загальне ──────────────────────────────────────────────
# Скільки лотів тягнути за один прохід (пагінація).
COLLECT_PAGE_LIMIT=100
# Захисний ліміт сторінок за запуск (щоб не впертись у rate limit).
COLLECT_MAX_PAGES=50
